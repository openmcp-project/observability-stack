{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "prConcurrentLimit": 5,
  "prCreation": "not-pending",
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Group all cert-manager updates together",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "groupName": "cert-manager",
      "matchPackageNames": [
        "/^quay\\.io/jetstack/cert-manager/"
      ]
    },
    {
      "description": "Group all OpenTelemetry updates together",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "groupName": "opentelemetry",
      "matchPackageNames": [
        "/opentelemetry-operator/",
        "/opentelemetry-collector/"
      ]
    },
    {
      "description": "Group all Prometheus updates together",
      "matchDatasources": [
        "docker",
        "github-releases"
      ],
      "groupName": "prometheus",
      "matchPackageNames": [
        "/prometheus-operator/",
        "/^quay\\.io/prometheus/prometheus/"
      ]
    },
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false,
      "automergeType": "pr"
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Disable digest pinning for custom regex managers",
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "description": "Update cert-manager version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "CERT_MANAGER_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cert-manager/cert-manager",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update metrics-operator version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "METRICS_OPERATOR_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openmcp-project/metrics-operator",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update kube-rbac-proxy version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "KUBE_RBAC_PROXY_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "brancz/kube-rbac-proxy",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update OpenTelemetry Operator chart version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "OPEN_TELEMETRY_OPERATOR_CHART_VERSION:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/open-telemetry/opentelemetry-helm-charts/opentelemetry-operator",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update OpenTelemetry Operator image version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "OPEN_TELEMETRY_OPERATOR_IMAGE_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/open-telemetry/opentelemetry-operator/opentelemetry-operator",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update OpenTelemetry Collector image version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "OPEN_TELEMETRY_COLLECTOR_IMAGE_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/otel/opentelemetry-collector-contrib",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Prometheus Operator image version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "PROMETHEUS_OPERATOR_IMAGE_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus-operator/prometheus-operator",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Prometheus Operator config reloader version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "PROMETHEUS_OPERATOR_CONFIG_RELOADER_IMAGE_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus-operator/prometheus-config-reloader",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Prometheus image version in component-settings.yaml",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "PROMETHEUS_IMAGE_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus/prometheus",
      "versioningTemplate": "semver"
    },
    {
      "description": "Track Prometheus Operator bundle.yaml version via operator.yaml annotation",
      "customType": "regex",
      "fileMatch": ["^kustomizations/prometheus-operator/operator\\.yaml$"],
      "matchStrings": [
        "operator\\.prometheus\\.io/version:\\s*(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prometheus-operator/prometheus-operator",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Update OpenMCP Operator version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "OPENMCP_OPERATOR_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/openmcp-operator",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Cluster Provider Kind version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "CLUSTER_PROVIDER_KIND_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/cluster-provider-kind",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Platform Service Gateway version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "PLATFORM_SERVICE_GATEWAY_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/platform-service-gateway",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update KRO version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "KRO_VERSION:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "registry.k8s.io/kro/charts/kro",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update OCM K8s Toolkit version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "fileMatch": ["^component-settings\\.yaml$"],
      "matchStrings": [
        "OCM_K8S_TOOLKIT_VERSION:\\s*\"(?<currentValue>[0-9.]+-[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/open-component-model/kubernetes/controller/chart",
      "versioningTemplate": "loose"
    }
  ],
  "ignoreDeps": [],
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "github-actions",
    "kubernetes",
    "kustomize",
    "custom.regex"
  ]
}
