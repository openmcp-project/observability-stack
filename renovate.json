{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "prHourlyLimit": 5,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Group all cert-manager updates together",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "groupName": "cert-manager",
      "matchPackageNames": [
        "/^quay\\.io/jetstack/cert-manager/"
      ]
    },
    {
      "description": "Group all OpenTelemetry updates together",
      "matchDatasources": [
        "docker",
        "github-releases"
      ],
      "groupName": "opentelemetry",
      "matchPackageNames": [
        "/opentelemetry-operator/",
        "/opentelemetry-collector/",
        "/opentelemetry-helm-charts/"
      ]
    },
    {
      "description": "Group all Prometheus updates together",
      "matchDatasources": [
        "docker",
        "github-releases"
      ],
      "groupName": "prometheus",
      "matchPackageNames": [
        "/prometheus-operator/",
        "/^quay\\.io/prometheus/prometheus/",
        "/^quay\\.io/prometheus/alertmanager/"
      ]
    },
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false,
      "automergeType": "pr"
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all E2E Go module dependency updates together (direct only)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "e2e-go-dependencies",
      "automerge": false
    },
    {
      "description": "Disable digest pinning for custom regex managers",
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": false
    },
    {
      "description": "Group all E2E test dependency updates together",
      "matchFileNames": [
        "component-settings.yaml"
      ],
      "groupName": "e2e-test-dependencies",
      "automerge": false,
      "matchPackageNames": [
        "/openmcp-project/images/",
        "/kro/charts/kro/",
        "/open-component-model/kubernetes/"
      ]
    },
    {
      "description": "Group KRO updates together across go.mod and component-settings.yaml",
      "matchPackageNames": [
        "github.com/kubernetes-sigs/kro",
        "registry.k8s.io/kro/charts/kro"
      ],
      "groupName": "kro",
      "automerge": false
    },
    {
      "description": "Group OCM K8s Toolkit updates together across go.mod and component-settings.yaml",
      "matchPackageNames": [
        "ocm.software/open-component-model/kubernetes/controller",
        "ghcr.io/open-component-model/kubernetes/controller/chart"
      ],
      "groupName": "ocm-k8s-toolkit",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Update cert-manager version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "CERT_MANAGER_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cert-manager/cert-manager",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "CERT_MANAGER_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update metrics-operator version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "METRICS_OPERATOR_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openmcp-project/metrics-operator",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "METRICS_OPERATOR_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update kube-rbac-proxy version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "KUBE_RBAC_PROXY_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "brancz/kube-rbac-proxy",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "KUBE_RBAC_PROXY_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update OpenTelemetry Operator chart version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "OPEN_TELEMETRY_OPERATOR_CHART_VERSION:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "open-telemetry/opentelemetry-helm-charts",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^opentelemetry-operator-(?<version>.*)$",
      "autoReplaceStringTemplate": "OPEN_TELEMETRY_OPERATOR_CHART_VERSION: \"{{{newValue}}}\""
    },
    {
      "description": "Update OpenTelemetry Operator image version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "OPEN_TELEMETRY_OPERATOR_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/open-telemetry/opentelemetry-operator/opentelemetry-operator",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "OPEN_TELEMETRY_OPERATOR_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update OpenTelemetry Collector image version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "OPEN_TELEMETRY_COLLECTOR_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/otel/opentelemetry-collector-contrib",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "OPEN_TELEMETRY_COLLECTOR_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Prometheus Operator image version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "PROMETHEUS_OPERATOR_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus-operator/prometheus-operator",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "PROMETHEUS_OPERATOR_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Prometheus Operator config reloader version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "PROMETHEUS_OPERATOR_CONFIG_RELOADER_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus-operator/prometheus-config-reloader",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "PROMETHEUS_OPERATOR_CONFIG_RELOADER_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Prometheus image version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "PROMETHEUS_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus/prometheus",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "PROMETHEUS_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Alertmanager image version in component-settings.yaml",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "ALERTMANAGER_IMAGE_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/prometheus/alertmanager",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "ALERTMANAGER_IMAGE_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update OpenMCP Operator version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "OPENMCP_OPERATOR_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/openmcp-operator",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "OPENMCP_OPERATOR_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Cluster Provider Kind version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "CLUSTER_PROVIDER_KIND_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/cluster-provider-kind",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "CLUSTER_PROVIDER_KIND_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update Platform Service Gateway version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "PLATFORM_SERVICE_GATEWAY_VERSION:\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/openmcp-project/images/platform-service-gateway",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "PLATFORM_SERVICE_GATEWAY_VERSION: \"v{{{newValue}}}\""
    },
    {
      "description": "Update KRO version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "KRO_VERSION:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "registry.k8s.io/kro/charts/kro",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "KRO_VERSION: \"{{{newValue}}}\""
    },
    {
      "description": "Update OCM K8s Toolkit version in component-settings.yaml (E2E test dependency)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^component-settings\\.yaml$/"
      ],
      "matchStrings": [
        "OCM_K8S_TOOLKIT_VERSION:\\s*\"v?(?<currentValue>[0-9.]+(?:-[a-zA-Z0-9.]+)?)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/open-component-model/kubernetes/controller/chart",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "OCM_K8S_TOOLKIT_VERSION: \"{{{newValue}}}\""
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "github-actions",
    "gomod",
    "kubernetes",
    "kustomize",
    "custom.regex"
  ]
}
